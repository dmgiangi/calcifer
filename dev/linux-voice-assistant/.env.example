# Copy to .env and adjust only the host-specific values.

# The Pop!_OS user running the PipeWire/PulseAudio session.
LVA_USER_ID=1000
LVA_USER_GROUP=1000
LVA_AUDIO_GROUP=audio

# PipeWire's PulseAudio-compatible runtime paths.
LVA_XDG_RUNTIME_DIR=/run/user/1000
LVA_PULSE_SERVER=/run/user/1000/pulse/native
LVA_PULSE_COOKIE=/run/user/1000/pulse/cookie

# LVA API and local device configuration.
LVA_PORT=6053
CLIENT_NAME=linux-voice-assistant
AUDIO_INPUT_DEVICE="Family 17h/19h HD Audio Controller Analog Stereo"
AUDIO_OUTPUT_DEVICE=pipewire
WAKE_WORD_DIR=/app/wakewords/custom
WAKE_MODEL=calcifer